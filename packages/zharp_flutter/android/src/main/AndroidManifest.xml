<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Zharp sends errors and telemetry over HTTPS. `flutter create` grants INTERNET only to
         debug builds, so a release build of a new app would capture its errors and fail to send
         them; declared here, it is merged into the app. -->
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
